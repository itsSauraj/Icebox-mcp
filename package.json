{
  "name": "icebox",
  "version": "2.0.0",
  "type": "module",
  "description": "Icebox - an MCP server of interactive mini apps and 24 games: Tetris, 2048, Minesweeper, Quiz Duel, Story Quest, Codenames and a full arcade",
  "license": "MIT",
  "author": "Saurabh Yadav (https://saurabh-yadav.me)",
  "homepage": "https://saurabh-yadav.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsSauraj/Icebox-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/itsSauraj/Icebox-mcp/issues"
  },
  "main": "dist/server.js",
  "scripts": {
    "gen": "node scripts/gen-entries.mjs",
    "build:apps": "node scripts/build-apps.mjs",
    "build:apps:dev": "node scripts/build-apps.mjs --dev",
    "bundle:html": "node scripts/bundle-html.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run gen && npm run build:apps && npm run bundle:html && npm run typecheck",
    "build:dev": "npm run gen && npm run build:apps:dev && npm run bundle:html",
    "vercel-build": "npm run gen && npm run build:apps && npm run bundle:html",
    "dev:ui": "npm run gen && cross-env NODE_ENV=development vite",
    "serve": "tsx main.ts",
    "serve:stdio": "tsx main.ts --stdio",
    "start": "npm run build && npm run serve"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.22",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
